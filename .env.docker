APP_NAME=FridgeManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Используем PostgreSQL для Docker
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=fridge
DB_USERNAME=fridge_user
DB_PASSWORD=db_password

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379