<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="database"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="fridge_testing"/>
        <env name="DB_USERNAME" value="fridge_user"/>
        <env name="DB_PASSWORD" value="db_password"/>
    </php>
</phpunit>